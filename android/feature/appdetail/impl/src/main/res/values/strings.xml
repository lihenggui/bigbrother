<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What an app did with a path. -->
    <string name="action_read">Read</string>
    <string name="action_write">Modified</string>
    <string name="action_read_write">Read and modified</string>
    <string name="action_list">Listed</string>
    <string name="action_probe">Probed</string>
    <string name="action_watch">Watched</string>
    <string name="action_read_provider">Read via provider</string>
    <string name="action_write_provider">Modified via provider</string>
    <string name="action_query">Queried</string>
    <string name="action_connect">Connected</string>
    <string name="action_exec">Executed</string>
    <string name="action_call">Called</string>
    <string name="search_paths">Search paths</string>
    <!-- A media library query: how many times the app listed a collection
         (the quantity) and the most entries one listing returned. -->
    <plurals name="access_query">
        <item quantity="one">Queried once, %2$d entries</item>
        <item quantity="other">Queried %1$d times, up to %2$d entries</item>
    </plurals>

    <string name="internal_storage">Internal storage</string>
    <string name="internal_storage_user">Internal storage (user %d)</string>

    <!-- Well-known media library collections. -->
    <string name="collection_images">Photos</string>
    <string name="collection_videos">Videos</string>
    <string name="collection_audio">Music and audio</string>
    <string name="collection_downloads">Downloads</string>
    <string name="collection_files">All media and files</string>
    <string name="collection_documents">Folders granted via document picker</string>

    <string name="results_truncated">Showing the most recent entries only.</string>

    <!-- What was done to a path and how often, kept short because several of
         these share a line. %1$s is an action such as "Read"; "denied" means
         the system refused. -->
    <string name="access_allowed">%1$s %2$d×</string>
    <string name="access_blocked">%1$s %2$d×, denied</string>
    <string name="access_partly_blocked">%1$s %2$d× (%3$d× denied)</string>
    <string name="access_separator">"; "</string>
    <!-- Between a count and when it last happened: "Called 5 times · 8 min. ago". -->
    <string name="time_separator" translatable="false">" · "</string>
    <!-- Outcome for a whole group of files: how often and whether denied. -->
    <plurals name="total_allowed">
        <item quantity="one">Read %d time</item>
        <item quantity="other">Read %d times</item>
    </plurals>
    <!-- A request to a system service: what it answered is not known. -->
    <plurals name="total_requested">
        <item quantity="one">Called %d time</item>
        <item quantity="other">Called %d times</item>
    </plurals>
    <plurals name="total_contacted">
        <item quantity="one">Connected %d time</item>
        <item quantity="other">Connected %d times</item>
    </plurals>
    <plurals name="total_ran">
        <item quantity="one">Executed %d time</item>
        <item quantity="other">Executed %d times</item>
    </plurals>
    <plurals name="total_not_run">
        <item quantity="one">Execution failed %d time</item>
        <item quantity="other">Execution failed %d times</item>
    </plurals>
    <plurals name="total_blocked">
        <item quantity="one">Denied %d time</item>
        <item quantity="other">Denied %d times</item>
    </plurals>
    <string name="removable_storage">Storage %s</string>

    <!-- Filter: files the system let the app open, or everything it did. -->
    <string name="filter_read">Read</string>
    <string name="filter_all">All access</string>
    <string name="no_files_read">No file reads</string>

    <!-- First part of the path bar when there are several storage volumes. -->
    <string name="storage_root">Storage</string>
    <!-- Groups listed next to the files, opened like folders. -->
    <string name="group_media">Media library</string>

    <string name="tab_files">Files</string>
    <!-- How many times a file was read. -->
    <string name="read_count">%d×</string>

    <string name="open_file_missing">File not found.</string>
    <string name="open_file_no_viewer">No app can open this file.</string>

    <string name="open_file_no_access">Shared storage is not accessible. Check that root access is granted.</string>

    <!-- File details: opens the file in a viewer app. -->
    <string name="open_file">Open</string>
    <!-- Several accesses within an hour: first time, then the last. -->
    <string name="time_span">%1$s – %2$s</string>
    <!-- Expand icon on a row that reveals the exact paths. -->
    <string name="show_details">Show details</string>
    <string name="hide_details">Hide details</string>
    <string name="show_all_details">Show all %d</string>
    <!-- How many other apps an app asked the system about. -->
    <plurals name="apps_asked">
        <item quantity="one">Looked up %d app</item>
        <item quantity="other">Looked up %d apps</item>
    </plurals>
    <string name="tab_info">App info</string>
    <!-- Tab title with the number of items in it: "Contacts (3)". -->
    <string name="tab_with_count">%1$s (%2$d)</string>
    <!-- Under the app's name: its package, then the time range the records cover. -->
    <string name="header_subtitle">%1$s · %2$s</string>
    <!-- Marks a row that comes from the system's permission records. -->
    <string name="source_permissions">Permission record</string>
    <plurals name="total_used">
        <item quantity="one">Used %d time</item>
        <item quantity="other">Used %d times</item>
    </plurals>
    <!-- App info tab. -->
    <string name="info_package">Package name</string>
    <string name="info_uid">UID</string>
    <string name="info_version">Version</string>
    <!-- %1$s is the version name, %2$d the version code. -->
    <string name="info_version_value">%1$s (%2$d)</string>
    <string name="info_target_sdk">Target SDK</string>
    <string name="info_min_sdk">Minimum SDK</string>
    <string name="info_first_install">Installed</string>
    <string name="info_last_update">Last updated</string>
    <string name="info_records">Records shown</string>
    <string name="info_open_settings">App settings</string>
    <string name="info_launch">Open app</string>
    <string name="info_copied">Copied</string>
    <!-- Marks a row done by one of the app's sandboxed (isolated) processes, such as a web renderer. -->
    <string name="source_isolated">Isolated process</string>
</resources>
