<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the app list, which is the app's home screen. -->
    <string name="app_list_title" translatable="false">Big Brother</string>
    <!-- Daemon status, shown under the title. -->
    <string name="status_stopped">Not recording: the daemon is not running</string>
    <!-- Time ranges. Lower case because they end the sentence under the title;
         the menu capitalizes them. -->
    <string name="range_hour">last hour</string>
    <string name="range_day">last 24 hours</string>
    <string name="range_week">last 7 days</string>
    <string name="range_all">all time</string>
    <!-- App list sections. -->
    <string name="section_files">Read your files</string>
    <string name="section_other">Other activity</string>
    <!-- Per-app summary, e.g. "12 files, 19 device items, 4 system items". -->
    <plurals name="summary_storage">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>
    <string name="summary_separator">", "</string>
    <string name="search_apps">Search apps</string>
    <string name="sort">Sort</string>
    <string name="sort_files">Files read</string>
    <string name="sort_recent">Most recent</string>
    <string name="sort_name">Name</string>
    <!-- An app's name followed by the Android user it runs as, for cloned apps
         and work profiles: "WeChat (user 999)". -->
    <string name="app_name_with_user">%1$s (user %2$d)</string>
    <string name="empty_body">Try a longer time range.</string>
    <string name="install_module">Install module</string>
    <string name="module_outdated">The installed module is older than this app.</string>
    <string name="update_module">Update</string>
    <string name="installing_module">Installing the module…</string>
    <string name="reboot_title">Restart to finish</string>
    <string name="reboot_body">Restart the device to start recording.</string>
    <string name="install_failed_title">Could not install the module</string>

    <!-- Under the title: the headline answer for the selected time range. -->
    <plurals name="status_summary">
        <item quantity="one">%d app read your files</item>
        <item quantity="other">%d apps read your files</item>
    </plurals>
    <string name="status_none">No app read your files</string>

    <!-- Row summary: folders named, then how many more. %1$s is a list of folder names. -->
    <plurals name="summary_folders_more">
        <item quantity="one">%1$s and %2$d more folder</item>
        <item quantity="other">%1$s and %2$d more folders</item>
    </plurals>
    <string name="summary_media_library">Media library</string>
    <!-- %1$s is a list of kinds of device information. -->
    <plurals name="summary_topics_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>

    <string name="show_system_apps">Show system apps</string>

    <string name="module_pending_reboot">Restart to finish updating the module.</string>

    <!-- Folders an app looked into or was refused, without reading anything. %s is a list of folder names. -->
    <string name="summary_not_read">%s, nothing read</string>

    <string name="more_options">More options</string>
    <string name="menu_time_range">Time range</string>
    <!-- Headline under the title with the time range it covers:
         "23 apps read your files, last 24 hours". %2$s is a time range. -->
    <string name="status_in_range">%1$s, %2$s</string>

    <string name="only_system_apps">Only system apps have records</string>
</resources>
