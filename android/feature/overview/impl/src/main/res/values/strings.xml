<resources>
    <!-- Files card: the number of apps comes first, in large type, then this. -->
    <plurals name="readers_label">
        <item quantity="one">app read files</item>
        <item quantity="other">apps read files</item>
    </plurals>
    <string name="no_reads">No app read files</string>
    <!-- Apps that listed, probed or watched files, or were denied, without reading any. -->
    <plurals name="looked_only">
        <item quantity="one">%d more app looked for files without reading them</item>
        <item quantity="other">%d more apps looked for files without reading them</item>
    </plurals>
    <!-- Apps beyond those whose icons are shown. -->
    <string name="more_count">+%d</string>
    <string name="other_categories">Other sensitive permissions</string>
    <plurals name="category_count">
        <item quantity="one">%d kind</item>
        <item quantity="other">%d kinds</item>
    </plurals>

    <!-- Groups on the files page. -->
    <plurals name="category_group_read_files">
        <item quantity="one">%d app read files</item>
        <item quantity="other">%d apps read files</item>
    </plurals>
    <plurals name="category_group_looked_only">
        <item quantity="one">%d app only looked for files</item>
        <item quantity="other">%d apps only looked for files</item>
    </plurals>

    <!-- Recording status, shown only when something needs attention. -->
    <string name="status_stopped">Recording stopped</string>
    <string name="daemon_stopped">The recording daemon is not running. Access in the meantime is not recorded.</string>
    <string name="daemon_starting">Starting the recording daemon…</string>
    <string name="daemon_not_reporting">The daemon was started but is not recording. See /data/adb/big_brother/bbd.log.</string>
    <string name="daemon_start_failed">Could not start the daemon: %s</string>
    <string name="module_disabled">The module is disabled. Enable it in the root manager.</string>
    <string name="start_daemon">Start recording</string>
    <string name="install_module">Install module</string>
    <string name="updating_module">Updating the module…</string>
    <string name="update_failed_title">Module update failed</string>
    <string name="module_pending_reboot">Module update takes effect after restart</string>
    <string name="installing_module">Installing module…</string>
    <string name="reboot_title">Restart required</string>
    <string name="reboot_body">Recording starts after the device restarts.</string>
    <string name="install_failed_title">Module installation failed</string>
</resources>
