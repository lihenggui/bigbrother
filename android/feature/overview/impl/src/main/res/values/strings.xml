<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Files card: the number of apps comes first, in large type, then this. -->
    <plurals name="readers_label">
        <item quantity="one">app read files</item>
        <item quantity="other">apps read files</item>
    </plurals>
    <string name="no_reads">No app read files</string>
    <!-- Apps that listed, probed or watched files, or were denied, without reading any. -->
    <plurals name="looked_only">
        <item quantity="one">%d more app looked for files without reading them</item>
        <item quantity="other">%d more apps looked for files without reading them</item>
    </plurals>
    <!-- Apps beyond those whose icons are shown. -->
    <string name="more_count">+%d</string>
    <string name="other_categories">Other kinds of data</string>
    <plurals name="category_count">
        <item quantity="one">%d kind</item>
        <item quantity="other">%d kinds</item>
    </plurals>

    <!-- Groups on the files page. -->
    <plurals name="category_group_read_files">
        <item quantity="one">%d app read files</item>
        <item quantity="other">%d apps read files</item>
    </plurals>
    <plurals name="category_group_looked_only">
        <item quantity="one">%d app only looked for files</item>
        <item quantity="other">%d apps only looked for files</item>
    </plurals>

