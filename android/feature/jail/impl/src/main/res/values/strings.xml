    <!-- Security: Android allows approximate location. Use the system Settings term. -->
    <string name="jail_mode_coarse">Approximate location</string>
    <!-- Security: Only precise location is withheld. -->
    <string name="jail_mode_coarse_detail">Precise location turned off; only an approximate location is available.</string>
    <!-- Security: Android allows access only while the app is in use. Use the system Settings term. -->
    <string name="jail_mode_foreground">Only while in use</string>
