<resources>
    <!-- The jail's list of apps. -->
    <!-- Heading for apps assigned to Jail. -->
    <string name="jail_section_isolated">Isolated apps</string>
    <!-- Heading for Jail settings. -->
    <string name="jail_section_settings">Settings</string>
    <!-- Opens the chooser for apps to isolate. -->
    <string name="jail_add_apps">Add apps</string>
    <!-- Defaults for apps that have no override. -->
    <string name="jail_global_settings">Global settings</string>
    <!-- Security: Summary of an app’s isolation selections. -->
    <string name="jail_all_items_on">Every item isolated</string>
    <!-- Security: %1$s lists the isolation items that are off. -->
    <string name="jail_items_off">Not isolated: %1$s</string>
    <!-- Security: No isolation item is enabled for this app. -->
    <string name="jail_no_items_on">No item isolated</string>
    <!-- Security: No apps are assigned to Jail. -->
    <string name="jail_empty_title">No isolated apps</string>
    <string name="jail_empty_files_title">Files</string>
    <!-- Security: Example of what isolated storage provides. -->
    <string name="jail_empty_files">Only a separate, empty storage of its own</string>
    <string name="jail_empty_permissions_title">Contacts, location, camera and more</string>
    <!-- Security: Permissions may appear granted even when the queries return no data. -->
    <string name="jail_empty_permissions">Permissions stay granted; queries return nothing</string>
    <string name="jail_empty_device_title">Device and apps</string>
    <!-- Security: Example of virtual identity and limited app visibility. -->
    <string name="jail_empty_device">A virtual Android ID; only system apps are visible</string>
    <!-- Security: Device identity and app visibility protections are unavailable. -->
    <string name="jail_hook_missing_title">Device identifiers and the app list are not hidden</string>
