    <string name="jail_gate_missing_title">Storage and processor information cannot be isolated</string>
    <!-- Security: Startup isolation cannot be applied. -->
    <string name="jail_gate_missing">Isolation is unavailable when apps start.</string>
    <!-- Security: The Android restrictions for these data sources are unavailable. -->
    <string name="jail_appops_missing_title">Contacts, location, camera and more are not isolated</string>
    <!-- Security: The component applying these Android restrictions is down. -->
    <string name="jail_appops_missing">The part of Big Brother that holds them back is not running. It starts again automatically.</string>

    <!-- Security: %1$s lists the apps successfully added to Jail. -->
    <string name="jail_isolated">%1$s isolated</string>
    <!-- Reverses the app isolation change described by the message. -->
    <string name="jail_undo">Undo</string>
    <!-- Security: The change failed. %1$s is a localized failure reason. -->
    <string name="jail_failed">Not changed: %1$s</string>
    <!-- Security: %1$s lists apps added to Jail. %2$s names the app the change failed for. -->
    <string name="jail_isolated_partly">%1$s isolated. Could not isolate %2$s</string>
    <!-- Security: %1$s lists apps added to Jail. %2$d counts the apps the change failed for. -->
    <plurals name="jail_isolated_partly_count">
        <item quantity="one">%1$s isolated. Could not isolate %2$d app</item>
        <item quantity="other">%1$s isolated. Could not isolate %2$d apps</item>
    </plurals>
    <!-- Security: %1$s names an app that could not be added to Jail. %2$s is the reason. -->
    <string name="jail_not_isolated">Could not isolate %1$s: %2$s</string>
    <!-- Security: %1$d counts apps that could not be added to Jail. %2$s is the reason. -->
    <plurals name="jail_not_isolated_count">
        <item quantity="one">Could not isolate %1$d app: %2$s</item>
        <item quantity="other">Could not isolate %1$d apps: %2$s</item>
    </plurals>
    <!-- Security: %1$s remains in Jail. %2$s is why ending isolation failed. -->
    <string name="jail_not_released">%1$s still isolated: %2$s</string>
    <!-- Security: %1$d apps remain in Jail. %2$s is why ending isolation failed. -->
    <plurals name="jail_not_released_count">
        <item quantity="one">%1$d app still isolated: %2$s</item>
        <item quantity="other">%1$d apps still isolated: %2$s</item>
    </plurals>

    <!-- Adding apps. -->
    <string name="jail_add_search">Search apps</string>
    <plurals name="jail_add_confirm">
        <item quantity="one">Isolate %d app</item>
        <item quantity="other">Isolate %d apps</item>
    </plurals>
    <!-- Action to place the selection in Jail. Shown when no apps are selected yet. -->
    <string name="jail_add_confirm_none">Isolate</string>
    <!-- Security: Applying isolation may end and restart running apps. -->
    <string name="jail_add_restart">Running apps are closed and restarted.</string>
    <string name="jail_add_empty">No apps to add</string>
    <string name="jail_close">Close</string>

    <!-- An app in the jail. -->
    <!-- Action to remove the app from Jail and restore its access. -->
    <string name="jail_release">End isolation</string>
    <!-- Opens the selected app’s recorded data access. -->
    <string name="jail_records">Records</string>
    <!-- Heading for individual kinds of data that Jail can isolate. -->
    <string name="jail_section_items">Isolation</string>
    <!-- Security: Enabled and disabled items give the app different data. -->
    <string name="jail_items_summary">Items that are on return empty or virtual data, or isolated storage. Items that are off keep the system\'s behaviour.</string>
    <!-- Remove the app’s overrides so it follows the global choices. -->
    <string name="jail_reset">Use global settings</string>
    <!-- Expands items for data the app has not requested. -->
    <plurals name="jail_more_items">
        <item quantity="one">%d more item the app does not ask for</item>
        <item quantity="other">%d more items the app does not ask for</item>
    </plurals>
    <string name="jail_fewer_items">Show less</string>
    <!-- Security: Describes the changes that restart the app. -->
    <string name="jail_restart_note">Turning an item on, or changing storage or processor information, restarts the app.</string>
    <!-- This app overrides at least one global isolation setting. -->
    <string name="jail_custom">Custom</string>
    <!-- For screen readers: whether an item's choices are shown, and what tapping the item does. -->
    <string name="jail_choices_shown">Expanded</string>
    <string name="jail_choices_hidden">Collapsed</string>
    <string name="jail_show_choices">Show choices</string>
    <string name="jail_hide_choices">Hide choices</string>
    <!-- Security: A setting is enabled, but the required framework hook is unavailable. -->
    <string name="jail_not_in_effect_hook">Not in effect: enable System Framework in LSPosed and restart</string>
    <!-- Security: Isolation that depends on the System Framework hook cannot run. -->
    <string name="jail_hook_unavailable">System Framework restrictions unavailable</string>
    <!-- Security: The framework restrictions cannot run on this Android version. -->
    <string name="jail_hook_incompatible">Not supported on this Android version</string>
    <!-- Security: Isolation provided by the framework hook became unavailable. -->
    <string name="jail_hook_degraded">Stopped working. Restart the device.</string>
    <!-- Security: The state of the framework restrictions cannot be verified. -->
    <string name="jail_hook_status_unknown">The status of the System Framework restrictions is unknown.</string>
    <!-- Security: An enabled storage restriction is not running. -->
    <string name="jail_not_in_effect_mounts">Not in effect: storage isolation is not running</string>
    <!-- Security: The startup gate failed to hold the app for isolation. -->
    <string name="jail_mount_start_failed">Could not hold the app at startup.</string>
    <!-- Security: Isolation could not be set up before the app started. -->
    <string name="jail_mount_setup_failed">Could not apply isolation at startup.</string>
    <!-- Security: The startup isolation attempt exceeded its time limit. -->
    <string name="jail_mount_timed_out">Isolation timed out at startup.</string>
    <!-- Security: Startup was prevented. %1$s is the specific failure reason. -->
    <string name="jail_mount_launch_refused">%1$s The app can’t start while this isolation is on. Turn off the affected items or remove the app from Jail to let it start.</string>
    <!-- Security: Android restriction readback is pending. -->
    <string name="jail_checking_app_ops">Checking Android restriction…</string>
    <!-- Security: Android restriction readback failed. The actual state is unknown. -->
    <string name="jail_app_ops_unknown">Android restriction could not be verified.</string>
    <!-- Security: The restriction is unavailable and the app may still get the data. -->
    <string name="jail_not_in_effect_app_ops">Restriction unavailable. The app may still have access.</string>

    <!-- The global settings. -->
    <!-- The global choices apply to isolated apps that have no override. -->
    <string name="jail_settings_subtitle">For isolated apps without their own setting</string>
    <string name="jail_auto_isolate">Isolate newly installed apps</string>
    <!-- Security: The global choices will apply to future app installs. -->
    <string name="jail_auto_isolate_summary">Use the settings below for future installs</string>
    <string name="jail_group_files">Files</string>
    <string name="jail_group_personal">Personal data</string>
    <string name="jail_group_sensors">Location and sensors</string>
    <string name="jail_group_device">Device and apps</string>
    <!-- Heading for the current state of the Jail components. -->
    <string name="jail_section_status">Status</string>
    <!-- The row opens details for the components that enforce Jail settings. -->
    <string name="jail_status_title">Components</string>
    <!-- Security: These components are available. Each app still has its own choices. -->
    <string name="jail_status_ok">Storage isolation, the system framework hook and network filtering in effect</string>
    <!-- Security: The current kernel cannot enforce the network restriction. -->
    <string name="jail_status_network_missing">Network filtering not available on this kernel</string>
    <!-- Security: The enforcing components’ states have not been determined yet. -->
    <string name="jail_status_checking">Checking…</string>
    <!-- Security: The framework hook is not active. -->
    <string name="jail_status_hook_missing">System framework hook not loaded</string>
    <!-- Security: Storage isolation cannot be applied. -->
    <string name="jail_status_gate_missing">Storage isolation unavailable</string>
    <!-- Security: Android restrictions for these items are unavailable. -->
    <string name="jail_status_appops_missing">Contacts, location and more not in effect</string>
    <!-- Security: A newly installed app may launch before isolation is applied. -->
    <string name="jail_status_new_apps_not_held">New apps may start before isolation</string>
    <!-- Newly installed apps the daemon could not isolate yet. -->
    <!-- Security: These apps are waiting for isolation, and are prevented from launching. -->
    <plurals name="jail_status_new_apps_held">
        <item quantity="one">%d newly installed app not isolated yet; kept from starting</item>
        <item quantity="other">%d newly installed apps not isolated yet; kept from starting</item>
    </plurals>
    <!-- Security: Isolation failed and these apps can launch without restrictions. -->
    <plurals name="jail_status_new_apps_failed">
        <item quantity="one">Could not isolate %d new app. It can start without isolation.</item>
        <item quantity="other">Could not isolate %d new apps. They can start without isolation.</item>
    </plurals>
    <!-- Security: These apps are waiting for isolation. The text makes no claim about whether they can launch. -->
    <plurals name="jail_status_new_apps_pending">
        <item quantity="one">%d newly installed app not isolated yet</item>
        <item quantity="other">%d newly installed apps not isolated yet</item>
    </plurals>
    <string name="jail_release_all">End all isolation</string>
    <!-- Security: Ending isolation preserves existing files in isolated storage. -->
    <string name="jail_release_all_summary">Files in isolated storage are kept</string>
    <string name="jail_release_all_title">End all isolation?</string>
    <!-- Security: Confirms that app access is restored and isolated files are retained. -->
    <plurals name="jail_release_all_body">
        <item quantity="one">%d app gets real data again and is restarted. Files in isolated storage are kept.</item>
        <item quantity="other">%d apps get real data again and are restarted. Files in isolated storage are kept.</item>
    </plurals>
    <!-- Security: These apps remain isolated after the bulk action. -->
    <plurals name="jail_release_all_left">
        <item quantity="one">%d app is still isolated. Try again.</item>
        <item quantity="other">%d apps are still isolated. Try again.</item>
    </plurals>
    <string name="jail_cancel">Cancel</string>

    <!-- The items: a title, what the app gets with the item on, and what that means. -->
    <string name="jail_item_storage">Files and media</string>
    <!-- Security: Separate storage is available while the item is on. -->
    <string name="jail_item_storage_on">Isolated storage</string>
    <!-- Security: Distinguish isolated storage from a one-time file picker grant. -->
    <string name="jail_item_storage_on_detail">A separate, empty storage of its own, where what it saves stays. Real photos, downloads and documents are not visible; a file chosen for it in the system\'s file picker is open to it for that use only.</string>
    <string name="jail_item_cpu_info">Processor information</string>
    <!-- Security: Processor identification is limited while the item is on. -->
    <string name="jail_item_cpu_info_on">Chip model hidden</string>
    <!-- Security: The app still sees the core count and instruction set. -->
    <string name="jail_item_cpu_info_on_detail">The core count and instruction set stay; the chip model and other identifiers are removed.</string>
    <string name="jail_item_contacts">Contacts</string>
    <!-- Security: The app receives an empty contact list. -->
    <string name="jail_item_contacts_on">Empty list</string>
    <!-- Security: An apparently granted permission still returns no contacts. -->
    <string name="jail_item_contacts_on_detail">Shown as granted; contact queries return nothing.</string>
    <string name="jail_item_messages">Messages and call log</string>
    <!-- Security: The app receives an empty list of messages and call entries. -->
    <string name="jail_item_messages_on">Empty list</string>
    <!-- Security: An apparently granted permission still returns no messages or call entries. -->
    <string name="jail_item_messages_on_detail">Shown as granted; message and call log queries return nothing.</string>
    <string name="jail_item_calendar">Calendar</string>
    <!-- Security: The app receives an empty calendar. -->
    <string name="jail_item_calendar_on">Empty calendar</string>
    <!-- Security: An apparently granted permission still returns no calendar data. -->
    <string name="jail_item_calendar_on_detail">Shown as granted; calendar queries return nothing.</string>
    <string name="jail_item_clipboard_accounts">Clipboard and accounts</string>
    <!-- Security: Clipboard and account data are withheld. -->
    <string name="jail_item_clipboard_accounts_on">Empty</string>
    <!-- Security: The app sees no clipboard content or accounts. -->
    <string name="jail_item_clipboard_accounts_on_detail">The clipboard and the account list are empty.</string>
    <string name="jail_item_location">Location</string>
    <!-- Security: The app receives no location in this mode. -->
    <string name="jail_item_location_on">No location</string>
    <!-- Security: An apparently granted permission still returns no location. -->
    <string name="jail_item_location_on_detail">Shown as granted; no location is available.</string>
    <string name="jail_item_camera">Camera</string>
    <!-- Security: The app receives no camera image in this mode. -->
    <string name="jail_item_camera_on">Unavailable</string>
    <!-- Security: An apparently granted permission still returns no camera image. -->
    <string name="jail_item_camera_on_detail">Shown as granted; no camera image is available.</string>
    <string name="jail_item_microphone">Microphone</string>
    <!-- Security: The app receives silent audio in this mode. -->
    <string name="jail_item_microphone_on">Silence</string>
    <!-- Security: An apparently granted permission still results in silence. -->
    <string name="jail_item_microphone_on_detail">Shown as granted; recordings are silent.</string>
    <string name="jail_item_body_sensors">Body sensors and activity</string>
    <!-- Security: Body sensor and activity data are withheld. -->
    <string name="jail_item_body_sensors_on">No data</string>
    <!-- Security: Covers body measurements and physical activity data. -->
    <string name="jail_item_body_sensors_on_detail">Heart rate, steps and physical activity are not available.</string>
    <string name="jail_item_device_ids">Device identifiers</string>
    <!-- Security: The app receives a substitute Android ID. -->
    <string name="jail_item_device_ids_on">Virtual ID</string>
    <!-- Security: The app receives its own stable substitute for Android ID and loses access to the other listed identifiers. -->
    <string name="jail_item_device_ids_on_detail">A fixed virtual Android ID of its own; the advertising ID, phone number and phone state cannot be read.</string>
    <string name="jail_item_installed_apps">Installed apps</string>
    <!-- Security: Visibility of other installed apps is restricted. -->
    <string name="jail_item_installed_apps_on">System apps only</string>
    <!-- Security: The list still includes the isolated app itself and system apps. -->
    <string name="jail_item_installed_apps_on_detail">The installed app list holds only system apps and itself; usage statistics cannot be read.</string>
    <string name="jail_item_nearby_devices">Nearby devices</string>
    <!-- Security: The app finds no nearby devices while this is on. -->
    <string name="jail_item_nearby_devices_on">None found</string>
    <!-- Security: Both Wi-Fi and Bluetooth discovery are affected. -->
    <string name="jail_item_nearby_devices_on_detail">Bluetooth and Wi-Fi scans return nothing.</string>
    <string name="jail_item_notification_content">Notification content</string>
    <!-- Security: The app cannot read other apps’ notifications. -->
    <string name="jail_item_notification_content_on">No access</string>
    <!-- Security: Its own notifications still work and access is restored when isolation ends. -->
    <string name="jail_item_notification_content_on_detail">Cannot read the notifications of other apps; its own notifications still show. Restored when isolation ends.</string>
    <string name="jail_item_screen_content">Screen content</string>
    <!-- Security: The app’s accessibility services are switched off. -->
    <string name="jail_item_screen_content_on">No access</string>
    <!-- Security: Covers reading and acting on the screen. Access is restored when isolation ends. -->
    <string name="jail_item_screen_content_on_detail">Its accessibility services are off: it cannot read or act on what is on screen. Restored when isolation ends.</string>

