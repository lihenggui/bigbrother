<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps no data of its own (records live in the daemon's database),
     so nothing is backed up or transferred to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
