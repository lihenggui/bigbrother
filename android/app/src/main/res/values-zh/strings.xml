<resources>
    <string name="module_description">记录应用通过 Android 内容提供程序访问文件和查询个人数据的行为。为“监狱”（应用隔离功能）提供 Android ID、广告 ID、应用可见性和文件授权控制。</string>
    <string name="nav_overview">概览</string>
    <string name="nav_apps">应用</string>
    <string name="nav_timeline">时间线</string>
    <string name="nav_jail">监狱</string>

    <!-- First-launch guide. All access shown in the illustrations is sample data. -->
    <string name="guide_access_title">监测应用的数据访问</string>
    <string name="guide_access_body">Big Brother 记录各应用在何时读取了哪些数据，包括文件、位置、剪贴板和设备标识符。记录仅保存在本设备。</string>
    <string name="guide_timeline_title">查看访问时间线</string>
    <string name="guide_timeline_body">时间线按小时和应用归类访问记录。打开一条记录可查看详情。</string>
    <string name="guide_jail_title">隔离指定应用</string>
    <string name="guide_jail_body">隔离后，应用使用隔离存储，读取剪贴板时得到空内容，获取的设备 ID 为虚拟值。每个隔离项目可单独设置。</string>
    <string name="guide_skip">跳过</string>
    <string name="guide_next">下一页</string>
    <string name="guide_back">上一页</string>
    <string name="guide_start">开始使用</string>
    <string name="guide_progress">第 %1$d 页，共 %2$d 页</string>
    <string name="guide_guard_description">示例：保镖逐个查看四个应用，并记录各应用读取的数据。</string>
    <string name="guide_timeline_description">示例时间线：天气、购物、聊天和手电筒及各自读取的数据。</string>
    <string name="guide_jail_description">示例：天气已隔离，剪贴板为空，设备 ID 为虚拟值，使用隔离存储。</string>
