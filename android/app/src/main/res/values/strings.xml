    <!-- First-launch guide. All access shown in the illustrations is sample data. -->
    <string name="guide_access_title">Monitor access to personal data</string>
    <string name="guide_access_body">Big Brother records which data each app reads and when: files, location, the clipboard and device identifiers. Records are stored only on this device.</string>
    <string name="guide_timeline_title">View the timeline</string>
    <string name="guide_timeline_body">The timeline groups access by hour and by app. Open an entry for details.</string>
    <string name="guide_jail_title">Isolate selected apps</string>
    <string name="guide_jail_body">Isolation gives an app its own storage, an empty clipboard and a virtual device ID. Each item can be changed separately.</string>
