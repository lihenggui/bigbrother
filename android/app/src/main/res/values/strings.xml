    <string name="guide_guard_description">Sample: the bodyguard checks four apps and records what each one read.</string>
    <string name="guide_timeline_description">Sample timeline: Weather, Shop, Chat and Flashlight with what each one read.</string>
    <string name="guide_jail_description">Sample: Weather isolated, with an empty clipboard, a virtual device ID and isolated storage.</string>
