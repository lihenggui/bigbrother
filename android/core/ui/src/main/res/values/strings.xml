    <!-- The detail pane beside a list, before anything is selected. -->
    <string name="select_app">Select an app to see what it accessed</string>

    <!-- Summaries in list rows. -->
    <plurals name="summary_storage">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>
    <string name="summary_separator">", "</string>
    <!-- A shortened list: the first names, then how many are not named. -->
    <plurals name="summary_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>
    <string name="summary_media_library">Media library</string>
    <!-- Folders an app listed or was denied, without reading any file. %s is a list of folder names. -->
    <string name="summary_not_read">%s (not read)</string>
    <!-- An app's name followed by the Android user it runs as, for cloned apps
         and work profiles: "WeChat (user 999)". -->
    <string name="app_name_with_user">%1$s (user %2$d)</string>
    <plurals name="app_count">
        <item quantity="one">%d app</item>
        <item quantity="other">%d apps</item>
    </plurals>
    <!-- Between parts of a supporting line: "Location · 3 apps". -->
    <string name="dot_separator" translatable="false">" · "</string>

    <!-- Which way an app used the clipboard. Several share a line:
         "Read 3 times · Listens for changes · Written once". -->
    <plurals name="clipboard_read">
        <item quantity="one">Read once</item>
        <item quantity="other">Read %d times</item>
    </plurals>
    <string name="clipboard_listens">Listens for changes</string>
    <plurals name="clipboard_written">
        <item quantity="one">Written once</item>
        <item quantity="other">Written %d times</item>
    </plurals>
    <!-- Reads or writes the system refused every time. -->
    <plurals name="clipboard_read_denied">
        <item quantity="one">Read denied once</item>
        <item quantity="other">Read denied %d times</item>
    </plurals>
    <plurals name="clipboard_write_denied">
        <item quantity="one">Write denied once</item>
        <item quantity="other">Write denied %d times</item>
    </plurals>
    <!-- The same, shorter, for a line shared with more: "Read 3× · Listens · Written 1×". -->
    <string name="clipboard_read_short">Read %d×</string>
    <string name="clipboard_listens_short">Listens</string>
    <string name="clipboard_written_short">Written %d×</string>
    <string name="clipboard_read_denied_short">Read denied %d×</string>
    <string name="clipboard_write_denied_short">Write denied %d×</string>
    <!-- %1$s is a count of reads or writes, %2$d how many of them the system refused. -->
    <string name="clipboard_partly_denied">%1$s (%2$d\u00A0denied)</string>

